# ---------------------------------------------------------------------------
# Student Memory Copilot — backend environment (reference placeholders only)
# Copy to .env for local use, or set these as environment variables on the host.
# NEVER commit real secrets. .env is git-ignored. Do not put any of these in Android.
# ---------------------------------------------------------------------------

# Mode: MOCK (default, no external services), LOCAL, or PRODUCTION.
APP_MODE=MOCK

# Paid AI extraction. Leave false for MOCK. Must be true in PRODUCTION.
ENABLE_PAID_AI=false

# Development bearer token (non-production only). Rejected in PRODUCTION.
DEV_TOKEN=local-development-only

# Daily AI request caps.
DAILY_USER_AI_CALLS=5
DAILY_GLOBAL_AI_CALLS=50

# Server only. Never include this in the Android app.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Memory retrieval mode:
#   lexical  = labelled keyword search, no Qdrant / no embedding model (prototype-friendly)
#   semantic = local sentence-transformer + Qdrant vector database
# The prototype cloud deployment uses lexical so Qdrant is NOT required.
MEMORY_MODE=lexical

# ---------------------------------------------------------------------------
# PRODUCTION deployment (Render/Railway + Supabase). Uncomment/fill on the host.
# ---------------------------------------------------------------------------
# APP_MODE=PRODUCTION
# ENABLE_PAID_AI=true
# MEMORY_MODE=lexical

# Supabase PostgreSQL connection string (must start with "postgresql").
# Use the Supabase pooled/session connection string; SQLAlchemy + psycopg driver form:
# DATABASE_URL=postgresql+psycopg://postgres:<password>@<host>:5432/postgres

# Firebase project that issues the client ID tokens verified server-side.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to the Firebase service-account JSON mounted on the host (Application Default Credentials).
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json

# RevenueCat server-side secret key for Pro entitlement verification.
# REVENUECAT_SECRET_KEY=

# Only required when MEMORY_MODE=semantic (not used by the lexical prototype deploy).
# QDRANT_URL=https://your-qdrant-host:6333
# QDRANT_API_KEY=
