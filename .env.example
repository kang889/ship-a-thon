APP_MODE=MOCK
ENABLE_PAID_AI=false
DEV_TOKEN=local-development-only
DAILY_USER_AI_CALLS=5
DAILY_GLOBAL_AI_CALLS=50
# Server only. Never include these credentials in the Android app.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Local extraction can run without downloading a memory model or running Qdrant.
# Production requires semantic memory and the online dependencies.
MEMORY_MODE=lexical
